package pages

import "github.com/dcrespo1/kinops/internal/views/layouts"

templ Home() {
	@layouts.Base("KinOps", homeContent())
}

templ homeContent() {
	<section class="empty empty-state home-state">
		<span class="empty-icon" aria-hidden="true">⌂</span>
		<h1>KinOps</h1>
		<p>Your household operations hub is running.</p>
		<div class="actions"><a class="button" href="/daily">View today</a><a class="button secondary" href="/chores">Manage chores</a></div>
	</section>
}
