package components

import (
	"fmt"
	"time"

	"github.com/dcrespo1/kinops/internal/domain"
	"github.com/dcrespo1/kinops/internal/scheduling"
)

templ InstanceCard(item domain.DailyInstance, selectedDate time.Time) {
	<article
		class={ "task-card", templ.KV("task-done", item.Instance.Status == domain.InstanceDone), templ.KV("task-overdue", item.Instance.DueDate.Format(scheduling.DateLayout) < selectedDate.Format(scheduling.DateLayout)) }
		id={ fmt.Sprintf("instance-%d", item.Instance.ID) }
		style={ fmt.Sprintf("--person-color: %s", item.Assignee.Color) }
	>
		<div class="task-copy">
			<div class="task-heading">
				<h3>{ item.Chore.Name }</h3>
				if item.Instance.Status == domain.InstanceDone {
					<span class="status done">Done</span>
				} else if item.Instance.Status == domain.InstanceSkipped {
					<span class="status skipped">Skipped</span>
				} else if item.Instance.DueDate.Format(scheduling.DateLayout) < selectedDate.Format(scheduling.DateLayout) {
					<span class="status overdue">{ overdueLabel(item.Instance.DueDate, selectedDate) }</span>
				}
			</div>
			if item.Chore.Category != "" {
				<p class="task-category">{ item.Chore.Category }</p>
			}
			<p class="assignee"><span class="color-dot"></span>{ item.Assignee.Name }</p>
		</div>
		if item.Instance.Status == domain.InstanceDone {
			<form
				method="post"
				action={ templ.URL(fmt.Sprintf("/instances/%d/reopen?date=%s", item.Instance.ID, selectedDate.Format(scheduling.DateLayout))) }
				hx-patch={ fmt.Sprintf("/instances/%d/reopen?date=%s", item.Instance.ID, selectedDate.Format(scheduling.DateLayout)) }
				hx-target={ fmt.Sprintf("#instance-%d", item.Instance.ID) }
				hx-swap="outerHTML"
				hx-disabled-elt="button"
			>
				<button class="task-action undo" type="submit" aria-label={ "Reopen " + item.Chore.Name }>Undo</button>
			</form>
		} else if item.Instance.Status == domain.InstancePending {
			<form
				method="post"
				action={ templ.URL(fmt.Sprintf("/instances/%d/complete?date=%s", item.Instance.ID, selectedDate.Format(scheduling.DateLayout))) }
				hx-patch={ fmt.Sprintf("/instances/%d/complete?date=%s", item.Instance.ID, selectedDate.Format(scheduling.DateLayout)) }
				hx-target={ fmt.Sprintf("#instance-%d", item.Instance.ID) }
				hx-swap="outerHTML"
				hx-disabled-elt="button"
			>
				<button class="task-action complete" type="submit" aria-label={ "Complete " + item.Chore.Name }><span aria-hidden="true">✓</span><span>Complete</span></button>
			</form>
		}
	</article>
}

templ TransitionResult(item domain.DailyInstance, selectedDate time.Time, view domain.DailyView, removeCard bool) {
	if !removeCard {
		@InstanceCard(item, selectedDate)
	}
	<p id="daily-summary" hx-swap-oob="innerHTML">{ summary(view) }</p>
	for _, day := range view.People {
		<span id={ fmt.Sprintf("person-progress-%d", day.Person.ID) } hx-swap-oob="innerHTML">{ progress(day) }</span>
	}
}

func overdueLabel(due, selected time.Time) string {
	due = time.Date(due.Year(), due.Month(), due.Day(), 0, 0, 0, 0, selected.Location())
	days := 0
	for date := due; date.Before(selected); date = date.AddDate(0, 0, 1) {
		days++
	}
	if days <= 1 {
		return "Due yesterday"
	}
	return fmt.Sprintf("%d days overdue", days)
}

func summary(view domain.DailyView) string {
	total, done := 0, 0
	for _, day := range view.People {
		for _, item := range day.Today {
			total++
			if item.Instance.Status == domain.InstanceDone {
				done++
			}
		}
	}
	if total == 0 {
		return "No chores scheduled for this day."
	}
	if done == total {
		return "Everything scheduled is done."
	}
	return fmt.Sprintf("%d of %d chores complete", done, total)
}

func progress(day domain.PersonDay) string {
	done := 0
	for _, item := range day.Today {
		if item.Instance.Status == domain.InstanceDone {
			done++
		}
	}
	return fmt.Sprintf("%d/%d done", done, len(day.Today))
}
