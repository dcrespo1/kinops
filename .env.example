# Generate a hash with `just admin-password-hash`.
KINOPS_ADMIN_USERNAME=admin
# Keep the generated hash single-quoted because it contains dollar signs.
KINOPS_ADMIN_PASSWORD_HASH='generated-hash-here'
# Set this to true only when KinOps is served to the browser over HTTPS.
KINOPS_ADMIN_COOKIE_SECURE=false

# Optional deployment settings.
KINOPS_TIMEZONE=America/New_York
KINOPS_PORT=8081

# Mealie runs as a separate service and remains the source of truth for food.
MEALIE_PORT=9925
MEALIE_PUBLIC_URL=http://localhost:9925
# Configure both of these after creating a long-lived token in Mealie. KinOps
# requires the base URL and token together.
MEALIE_BASE_URL=
MEALIE_API_TOKEN=
MEALIE_DEFAULT_SHOPPING_LIST_ID=
MEALIE_REQUEST_TIMEOUT=5s
